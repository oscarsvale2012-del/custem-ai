{
  "name": "vyron",
  "productName": "VYRON",
  "version": "0.7.0",
  "description": "VYRON - AI game studio: many AI agents, MCP servers and Roblox Studio working together",
  "main": "main.js",
  "author": "VYRON",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev:web": "node src/devserver.js",
    "test": "node test/run.js && node test/revenue.js && node test/auth.js",
    "icon": "electron build/render-icon.js",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.136.0",
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.vyron.app",
    "productName": "VYRON",
    "copyright": "VYRON",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "src/**/*", "renderer/**/*", "package.json", "!src/devserver.js"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png",
      "executableName": "VYRON"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "VYRON",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "VYRON-Setup-${version}.${ext}"
    },
    "portable": { "artifactName": "VYRON-${version}-Portable.exe" }
  }
}
