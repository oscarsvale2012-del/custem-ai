{
  "name": "vyron",
  "productName": "VYRON",
  "version": "1.6.2",
  "description": "VYRON - desktop companion for Claude: build Roblox games with Claude, game ideas and DevEx kroner",
  "main": "main.js",
  "author": "VYRON",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev:web": "node src/devserver.js",
    "test": "node test/core.js && node test/revenue.js && node test/account.js && node test/bridge.js && node test/team.js",
    "icon": "electron build/render-icon.js",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.vyron.app",
    "productName": "VYRON",
    "copyright": "VYRON",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "!src/devserver.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "executableName": "VYRON"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "VYRON",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "VYRON-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "VYRON-${version}-Portable.exe"
    },
    "asarUnpack": [
      "src/mcp-bridge.js"
    ]
  }
}
